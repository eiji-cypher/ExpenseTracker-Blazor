@using ExpenseTracker.Models
@using ExpenseTracker.Services
@inject INotificationService Notifications
@inject NavigationManager Nav

<div class="backdrop-neo notif-backdrop" @onclick="OnClose">
    <aside class="notif-drawer-neo"
           role="dialog"
           aria-label="Transaction Activity Notifications"
           @onclick:stopPropagation="true">
        <div class="notif-drawer-header">
            <div class="notif-header-left">
                <div class="notif-bell-icon">
                    <svg class="icon" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.9 2 2 2zm6-6v-5c0-3.07-1.63-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.64 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z" />
                    </svg>
                </div>
                <div class="notif-title-group">
                    <h2 class="notif-title">Transaction Activity</h2>
                    <span class="notif-subtitle">@Notifications.Notifications.Count CRUD Events Recorded</span>
                </div>
            </div>

            <div class="notif-header-actions">
                @if (Notifications.Notifications.Count > 0)
                {
                    <button type="button"
                            class="notif-clear-btn"
                            @onclick="ClearLog"
                            title="Clear activity log">
                        Clear Log
                    </button>
                }
                <button type="button"
                        class="notif-close-btn"
                        @onclick="OnClose"
                        aria-label="Close activity log">
                    ✕
                </button>
            </div>
        </div>

        <div class="notif-tabs-bar" role="tablist">
            <button type="button"
                    class="notif-tab-btn @(_filter == "all" ? "active" : "")"
                    @onclick='() => _filter = "all"'>
                All (@Notifications.Notifications.Count)
            </button>
            <button type="button"
                    class="notif-tab-btn @(_filter == "income" ? "active" : "")"
                    @onclick='() => _filter = "income"'>
                Income
            </button>
            <button type="button"
                    class="notif-tab-btn @(_filter == "expense" ? "active" : "")"
                    @onclick='() => _filter = "expense"'>
                Expense
            </button>
            <button type="button"
                    class="notif-tab-btn @(_filter == "modified" ? "active" : "")"
                    @onclick='() => _filter = "modified"'>
                Modified
            </button>
        </div>

        <div class="notif-list-body">
            @{
                var filtered = FilteredItems.ToList();
            }

            @if (filtered.Count == 0)
            {
                <div class="notif-empty-state">
                    <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8" class="notif-empty-icon">
                        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" />
                        <path d="M13.73 21a2 2 0 0 1-3.46 0" />
                    </svg>
                    <p>No activity recorded yet.</p>
                </div>
            }
            else
            {
                <div class="notif-list-stack">
                    @foreach (var item in filtered)
                    {
                        var isIncome = item.Type == NotificationType.IncomeAdded;
                        var isExpense = item.Type == NotificationType.ExpenseAdded;
                        var isEdit = item.Type == NotificationType.TransactionUpdated;
                        var isDelete = item.Type == NotificationType.TransactionDeleted || item.Type == NotificationType.TransactionPurged;
                        var isRestore = item.Type == NotificationType.TransactionRestored;
                        var targetTitle = item.Type == NotificationType.TransactionDeleted || item.Type == NotificationType.TransactionPurged
                            ? "View in Recently Deleted"
                            : "View in Transactions";

                        <div class="notif-item-card @(item.IsRead ? "is-read" : "is-unread")"
                             @key="item.Id"
                             role="button"
                             tabindex="0"
                             title="@targetTitle"
                             @onclick="() => HandleItemClick(item)"
                             @onkeydown="(e) => HandleKeyDown(e, item)">
                            <div class="notif-item-left">
                                <div class="notif-icon-circle @(isIncome ? "income" : isExpense ? "expense" : isEdit ? "edit" : "delete")">
                                    @if (isIncome)
                                    {
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                            <line x1="17" y1="7" x2="7" y2="17" />
                                            <polyline points="17 17 7 17 7 7" />
                                        </svg>
                                    }
                                    else if (isExpense)
                                    {
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                            <line x1="7" y1="17" x2="17" y2="7" />
                                            <polyline points="7 7 17 7 17 17" />
                                        </svg>
                                    }
                                    else if (isEdit)
                                    {
                                        <span>✎</span>
                                    }
                                    else if (isRestore)
                                    {
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" />
                                            <path d="M3 3v5h5" />
                                        </svg>
                                    }
                                    else
                                    {
                                        <span>✕</span>
                                    }
                                </div>
                            </div>

                            <div class="notif-item-center">
                                <div class="notif-item-title-row">
                                    <strong class="notif-item-title">@item.Title</strong>
                                    @if (isIncome)
                                    {
                                        <span class="notif-tag income">Income</span>
                                    }
                                    else if (isExpense)
                                    {
                                        <span class="notif-tag expense">Expense</span>
                                    }
                                    else if (isEdit)
                                    {
                                        <span class="notif-tag edit">Modified</span>
                                    }
                                    else if (isRestore)
                                    {
                                        <span class="notif-tag income">Restored</span>
                                    }
                                    else
                                    {
                                        <span class="notif-tag delete">Removed</span>
                                    }
                                </div>

                                <p class="notif-item-desc">@item.Message</p>
                                <span class="notif-item-time">@item.TimeAgo</span>
                            </div>

                            <div class="notif-item-arrow" aria-hidden="true">
                                ›
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </aside>
</div>

@code {
    [Parameter] public EventCallback OnClose { get; set; }

    private string _filter = "all";

    private IEnumerable<SystemNotification> FilteredItems
    {
        get
        {
            var list = Notifications.Notifications;
            if (_filter == "income")
                return list.Where(n => n.Type == NotificationType.IncomeAdded);
            if (_filter == "expense")
                return list.Where(n => n.Type == NotificationType.ExpenseAdded);
            if (_filter == "modified")
                return list.Where(n => n.Type == NotificationType.TransactionUpdated || n.Type == NotificationType.TransactionDeleted || n.Type == NotificationType.TransactionPurged || n.Type == NotificationType.TransactionRestored);
            return list;
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e, SystemNotification item)
    {
        if (e.Key == "Enter" || e.Key == " ")
        {
            await HandleItemClick(item);
        }
    }

    private async Task HandleItemClick(SystemNotification item)
    {
        Notifications.MarkAsRead(item.Id);
        await OnClose.InvokeAsync();

        if (!string.IsNullOrEmpty(item.LinkUrl))
        {
            Nav.NavigateTo(item.LinkUrl);
        }
        else if (item.Type == NotificationType.TransactionDeleted || item.Type == NotificationType.TransactionPurged)
        {
            Nav.NavigateTo("deleted");
        }
        else
        {
            Nav.NavigateTo("history");
        }
    }

    private void ClearLog()
    {
        Notifications.ClearAll();
    }
}
