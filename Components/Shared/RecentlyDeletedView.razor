@using ExpenseTracker.Helpers
@using ExpenseTracker.Models

<div class="recently-deleted-view">
    <div class="card-header-neo">
        <div class="card-header-title-group">
            <div class="title-with-badge">
                <svg class="header-trash-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="3 6 5 6 21 6" />
                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                    <line x1="10" y1="11" x2="10" y2="17" />
                    <line x1="14" y1="11" x2="14" y2="17" />
                </svg>
                <h2>Recently Deleted</h2>
                <span class="card-header-badge warning">
                    @DeletedTransactions.Count in Trash
                </span>
            </div>
            <p class="card-header-desc">
                Deleted transactions remain preserved here until permanently purged or restored.
            </p>
        </div>

        <div class="card-header-actions-row">
            @if (DeletedTransactions.Count > 0)
            {
                <button type="button"
                        class="btn-neo-danger small"
                        @onclick="OnClearAll"
                        title="Permanently remove all items in trash">
                    Empty Trash
                </button>
            }
            @if (OnBack.HasDelegate)
            {
                <button type="button"
                        class="btn-neo-secondary small"
                        @onclick="OnBack">
                    ← Back to Dashboard
                </button>
            }
        </div>
    </div>

    @if (DeletedTransactions.Count == 0)
    {
        <div class="empty-state-box trash-empty">
            <div class="empty-icon-circle">🗑</div>
            <h3 class="empty-title">Trash is Clean &amp; Empty</h3>
            <p class="empty-text">
                Any income or expense entries you delete from the active list will remain here for recovery until you choose to permanently erase them.
            </p>
        </div>
    }
    else
    {
        <div class="deleted-items-grid">
            @foreach (var item in DeletedTransactions)
            {
                var isIncome = item.Type == TransactionType.Income;
                <div class="deleted-item-card-neo" @key="item.Id">
                    <div class="deleted-item-left">
                        <div class="tx-icon-circle @(isIncome ? "income" : "expense")">
                            @if (isIncome)
                            {
                                <svg class="icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="17" y1="7" x2="7" y2="17" />
                                    <polyline points="17 17 7 17 7 7" />
                                </svg>
                            }
                            else
                            {
                                <svg class="icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="7" y1="17" x2="17" y2="7" />
                                    <polyline points="7 7 17 7 17 17" />
                                </svg>
                            }
                        </div>
                        <div class="deleted-item-meta">
                            <div class="deleted-item-title-row">
                                <strong class="deleted-item-title">
                                    @(string.IsNullOrEmpty(item.Description) ? item.Category.ToString() : item.Description)
                                </strong>
                                <span class="deleted-category-pill">@item.Category</span>
                            </div>
                            <span class="deleted-date-sub">
                                Transaction Date: @item.Date.ToString("yyyy-MM-dd") · Deleted recently
                            </span>
                        </div>
                    </div>

                    <div class="deleted-item-right">
                        <div class="deleted-amount-col">
                            <span class="tx-amount @(isIncome ? "income" : "expense")">
                                @(isIncome ? "+" : "−")@Money.Format(item.Amount)
                            </span>
                            <span class="deleted-status-tag">Soft-Deleted</span>
                        </div>

                        <div class="deleted-actions-group">
                            <button type="button"
                                    class="btn-action-restore"
                                    @onclick="() => OnRestore.InvokeAsync(item.Id)"
                                    title="Restore back to active transactions">
                                <svg class="icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" />
                                    <path d="M3 3v5h5" />
                                </svg>
                                <span>Restore</span>
                            </button>
                            <button type="button"
                                    class="btn-action-purge"
                                    @onclick="() => OnPurge.InvokeAsync(item.Id)"
                                    title="Permanently erase from system">
                                <svg class="icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="3 6 5 6 21 6" />
                                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                                    <line x1="10" y1="11" x2="10" y2="17" />
                                    <line x1="14" y1="11" x2="14" y2="17" />
                                </svg>
                                <span>Delete Forever</span>
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public IReadOnlyList<Transaction> DeletedTransactions { get; set; } = Array.Empty<Transaction>();
    [Parameter] public EventCallback<int> OnRestore { get; set; }
    [Parameter] public EventCallback<int> OnPurge { get; set; }
    [Parameter] public EventCallback OnClearAll { get; set; }
    [Parameter] public EventCallback OnBack { get; set; }
}

