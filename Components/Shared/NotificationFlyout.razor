@implements IDisposable
@inject INotificationService Notifications
@inject NavigationManager Nav

<div class="notification-popover-surface" @onclick:stopPropagation="true">
    <!-- Flyout Header -->
    <div class="notif-header-row">
        <div class="notif-title-group">
            <h3 class="notif-title">System Activity</h3>
            @if (Notifications.UnreadCount > 0)
            {
                <span class="notif-unread-badge">@Notifications.UnreadCount New</span>
            }
        </div>

        <div class="notif-header-actions">
            @if (Notifications.UnreadCount > 0)
            {
                <button type="button" class="notif-action-btn" @onclick="Notifications.MarkAllAsRead">
                    Mark all read
                </button>
            }
            <button type="button" class="btn-modal-close" style="width:26px; height:26px; font-size: 0.8rem;" @onclick="OnClose" title="Close">✕</button>
        </div>
    </div>

    <!-- Filter Segmented Tabs -->
    <div class="notif-tabs-row">
        <button type="button"
                class="notif-tab-btn @(_filter == "all" ? "active" : "")"
                @onclick='() => _filter = "all"'>
            All (@Notifications.Notifications.Count)
        </button>
        <button type="button"
                class="notif-tab-btn @(_filter == "transactions" ? "active" : "")"
                @onclick='() => _filter = "transactions"'>
            Transactions
        </button>
        <button type="button"
                class="notif-tab-btn @(_filter == "system" ? "active" : "")"
                @onclick='() => _filter = "system"'>
            System &amp; Auth
        </button>
    </div>

    <!-- Notifications List -->
    <div class="notif-items-scroll">
        @{
            var filtered = FilteredNotifications.ToList();
        }

        @if (filtered.Count == 0)
        {
            <div class="notif-empty-state">
                <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8" class="notif-empty-icon">
                    <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" />
                    <path d="M13.73 21a2 2 0 0 1-3.46 0" />
                </svg>
                <p>No recent activity in this category.</p>
            </div>
        }
        else
        {
            <div class="notif-list-stack">
                @foreach (var item in filtered)
                {
                    <div class="notif-card-item @(item.IsRead ? "is-read" : "is-unread")"
                         @onclick="() => HandleItemClick(item)">
                        <!-- Type Icon -->
                        <div class="notif-icon-circle @GetIconClass(item.Type)">
                            @if (item.Type == NotificationType.IncomeAdded)
                            {
                                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5">
                                    <line x1="19" y1="5" x2="5" y2="19" />
                                    <polyline points="15 19 5 19 5 9" />
                                </svg>
                            }
                            else if (item.Type == NotificationType.ExpenseAdded)
                            {
                                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5">
                                    <line x1="7" y1="17" x2="17" y2="7" />
                                    <polyline points="7 7 17 7 17 17" />
                                </svg>
                            }
                            else if (item.Type == NotificationType.TransactionUpdated)
                            {
                                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2">
                                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
                                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" />
                                </svg>
                            }
                            else if (item.Type == NotificationType.TransactionDeleted)
                            {
                                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2">
                                    <line x1="18" y1="6" x2="6" y2="18" />
                                    <line x1="6" y1="6" x2="18" y2="18" />
                                </svg>
                            }
                            else if (item.Type == NotificationType.Authentication)
                            {
                                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2">
                                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                                    <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                                </svg>
                            }
                            else
                            {
                                <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor">
                                    <path d="M12 2L14.4 9.6L22 12L14.4 14.4L12 22L9.6 14.4L2 12L9.6 9.6L12 2z" />
                                </svg>
                            }
                        </div>

                        <!-- Content Info -->
                        <div class="notif-body">
                            <div class="notif-row-top">
                                <span class="notif-item-title">@item.Title</span>
                                <span class="notif-timestamp">@item.TimeAgo</span>
                            </div>
                            <div class="notif-item-msg">@item.Message</div>
                        </div>

                        <!-- Unread Dot -->
                        @if (!item.IsRead)
                        {
                            <span class="notif-unread-dot" title="Unread"></span>
                        }
                    </div>
                }
            </div>
        }
    </div>

    <!-- Flyout Footer -->
    <div class="notif-footer-row">
        <NavLink href="history" class="notif-footer-link" @onclick="OnClose">
            View Transaction History →
        </NavLink>
        @if (Notifications.Notifications.Count > 0)
        {
            <button type="button" class="notif-clear-btn" @onclick="Notifications.ClearAll">
                Clear All
            </button>
        }
    </div>
</div>

@code {
    [Parameter] public EventCallback OnClose { get; set; }

    private string _filter = "all";

    private IEnumerable<SystemNotification> FilteredNotifications
    {
        get
        {
            var list = Notifications.Notifications;
            if (_filter == "transactions")
            {
                return list.Where(n => n.Type is NotificationType.IncomeAdded
                                       or NotificationType.ExpenseAdded
                                       or NotificationType.TransactionUpdated
                                       or NotificationType.TransactionDeleted);
            }
            if (_filter == "system")
            {
                return list.Where(n => n.Type is NotificationType.Authentication or NotificationType.System);
            }
            return list;
        }
    }

    private void HandleItemClick(SystemNotification item)
    {
        Notifications.MarkAsRead(item.Id);
        if (!string.IsNullOrEmpty(item.LinkUrl))
        {
            Nav.NavigateTo(item.LinkUrl);
            OnClose.InvokeAsync();
        }
    }

    private string GetIconClass(NotificationType type) => type switch
    {
        NotificationType.IncomeAdded => "icon-income-bg",
        NotificationType.ExpenseAdded => "icon-expense-bg",
        NotificationType.TransactionUpdated => "icon-update-bg",
        NotificationType.TransactionDeleted => "icon-delete-bg",
        NotificationType.Authentication => "icon-auth-bg",
        _ => "icon-system-bg"
    };

    protected override void OnInitialized() => Notifications.OnChange += StateHasChanged;
    public void Dispose() => Notifications.OnChange -= StateHasChanged;
}

