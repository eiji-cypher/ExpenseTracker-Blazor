@using ExpenseTracker.Helpers
@using ExpenseTracker.Models

<div class="dashboard-view-content">
    <!-- Wallet Card / Balance Section -->
    <section class="balance-section">
        <div class="balance-meta-row">
            <div class="balance-label-group">
                <span class="balance-label">Total Balance</span>
                <span class="currency-pill">PHP</span>
            </div>
            <div class="trend-badge-group">
                <span class="trend-badge-pill active-balance">Active Balance</span>
            </div>
        </div>

        <div class="balance-main-amount">
            @Money.Format(Balance)
        </div>

        <div class="mobile-wallet-substats only-mobile">
            <div class="wallet-substat-pill income">
                <span class="substat-label">Inflow</span>
                <strong class="substat-val">+@Money.Format(Income)</strong>
            </div>
            <div class="wallet-substat-pill expense">
                <span class="substat-label">Outflow</span>
                <strong class="substat-val">−@Money.Format(Expense)</strong>
            </div>
        </div>
    </section>

    <!-- Quick Actions Bar (Full width Black Button) -->
    <section class="quick-actions-bar" aria-label="Quick Actions">
        <button type="button"
                class="btn-add-transaction-black"
                @onclick="OnOpenAdd"
                title="Add Transaction">
            <span class="plus-icon">+</span>
            <span class="action-label">Add Transaction</span>
        </button>
    </section>

    <!-- Overviews Section (12-Month Spline Curve) -->
    <section class="overviews-section">
        <div class="section-header-row">
            <div class="section-title-wrap">
                <h2 class="section-title">Overviews</h2>
                <span class="section-subtitle">Live Monthly Balance</span>
            </div>
            <button type="button"
                    class="view-history-link"
                    @onclick="OnViewHistory"
                    title="View full history">
                View History
            </button>
        </div>

        <SplineChart Transactions="Transactions" />
    </section>

    <!-- Recent Activity Section -->
    <section class="recent-activity-section">
        <div class="section-header-row">
            <div class="section-title-wrap">
                <h3 class="section-sub-title">Recent Activity</h3>
            </div>
        </div>

        <div class="activity-list">
            @{
                var recentList = Transactions.Take(5).ToList();
            }

            @if (recentList.Count == 0)
            {
                <div class="empty-activity-card">
                    <div class="empty-icon-circle small">
                        <svg class="icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10" />
                            <polyline points="12 6 12 12 16 14" />
                        </svg>
                    </div>
                    <p class="empty-headline">No transactions recorded yet</p>
                    <span class="empty-subtext">Recent activity will appear here as you log income and expenses.</span>
                    <button type="button"
                            class="btn-neo-primary small"
                            @onclick="OnOpenAdd">
                        + Record your first entry
                    </button>
                </div>
            }
            else
            {
                @foreach (var t in recentList)
                {
                    var isIncome = t.Type == TransactionType.Income;
                    <div class="recent-tx-row-card" @key="t.Id">
                        <div class="tx-icon-circle @(isIncome ? "income" : "expense")">
                            @if (isIncome)
                            {
                                <svg class="icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="17" y1="7" x2="7" y2="17" />
                                    <polyline points="17 17 7 17 7 7" />
                                </svg>
                            }
                            else
                            {
                                <svg class="icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="7" y1="17" x2="17" y2="7" />
                                    <polyline points="7 7 17 7 17 17" />
                                </svg>
                            }
                        </div>

                        <div class="tx-details">
                            <span class="tx-title" title="@(string.IsNullOrEmpty(t.Description) ? t.Category.ToString() : t.Description)">
                                @(string.IsNullOrEmpty(t.Description) ? t.Category.ToString() : t.Description)
                            </span>
                            <span class="tx-subtitle">
                                @t.Category · @t.Date.ToString("MMM dd, yyyy")
                            </span>
                        </div>

                        <div class="tx-amount-col">
                            <span class="tx-amount @(isIncome ? "income" : "expense")">
                                @(isIncome ? "+" : "−")@Money.Format(t.Amount)
                            </span>
                            <span class="tx-time">@t.RecordTimeFormatted</span>
                        </div>

                        <div class="tx-mini-actions">
                            <button type="button"
                                    class="mini-btn-icon"
                                    @onclick="() => OnEdit.InvokeAsync(t)"
                                    title="Edit transaction"
                                    aria-label="Edit">
                                ✎
                            </button>
                            <button type="button"
                                    class="mini-btn-icon danger"
                                    @onclick="() => OnDelete.InvokeAsync(t)"
                                    title="Move to trash"
                                    aria-label="Delete">
                                ✕
                            </button>
                        </div>
                    </div>
                }
            }
        </div>
    </section>
</div>

@code {
    [Parameter] public decimal Balance { get; set; }
    [Parameter] public decimal Income { get; set; }
    [Parameter] public decimal Expense { get; set; }
    [Parameter] public IReadOnlyList<Transaction> Transactions { get; set; } = Array.Empty<Transaction>();
    [Parameter] public EventCallback OnOpenAdd { get; set; }
    [Parameter] public EventCallback OnViewHistory { get; set; }
    [Parameter] public EventCallback<Transaction> OnEdit { get; set; }
    [Parameter] public EventCallback<Transaction> OnDelete { get; set; }
}
