<div class="floating-dock-wrapper">
    <nav class="floating-dock" aria-label="Main Navigation">
        <button type="button"
                class="dock-btn @(CurrentView == "dashboard" ? "active" : "")"
                @onclick='() => OnViewChanged.InvokeAsync("dashboard")'
                title="Dashboard"
                aria-label="Dashboard">
            <svg class="icon" width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
                <path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z" />
            </svg>
        </button>

        <button type="button"
                class="dock-btn @(CurrentView == "history" ? "active" : "")"
                @onclick='() => OnViewChanged.InvokeAsync("history")'
                title="Transactions"
                aria-label="Transactions">
            <svg class="icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 12V7H5a2 2 0 0 1 0-4h14v4" />
                <path d="M3 5v14a2 2 0 0 0 2 2h16v-5" />
                <path d="M18 12a2 2 0 0 0 0 4h4v-4z" />
            </svg>
        </button>

        <button type="button"
                class="dock-action-chrome-btn"
                @onclick="OnQuickAdd"
                title="Add Transaction"
                aria-label="Add Transaction">
            <div class="chrome-reflection-highlight"></div>
            <svg class="icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2C12 7.52 7.52 12 2 12C7.52 12 12 16.48 12 22C12 16.48 16.48 12 22 12C16.48 12 12 7.52 12 2Z" />
            </svg>
        </button>

        <button type="button"
                class="dock-btn @(CurrentView == "analytics" ? "active" : "")"
                @onclick='() => OnViewChanged.InvokeAsync("analytics")'
                title="Analytics"
                aria-label="Analytics">
            <svg class="icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M2 12c3-6 6-6 9 0s6 6 9 0" />
                <circle cx="15.5" cy="8.5" r="1.5" fill="currentColor" />
            </svg>
        </button>

        <button type="button"
                class="dock-btn @(CurrentView == "deleted" ? "active" : "")"
                @onclick='() => OnViewChanged.InvokeAsync("deleted")'
                title="Recently Deleted"
                aria-label="Recently Deleted">
            <div class="dock-icon-rel">
                <svg class="icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="3 6 5 6 21 6" />
                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                    <line x1="10" y1="11" x2="10" y2="17" />
                    <line x1="14" y1="11" x2="14" y2="17" />
                </svg>
                @if (DeletedCount > 0)
                {
                    <span class="dock-badge-dot"></span>
                }
            </div>
        </button>
    </nav>
    <div class="mobile-home-indicator"></div>
</div>

@code {
    [Parameter] public string CurrentView { get; set; } = "dashboard";
    [Parameter] public EventCallback<string> OnViewChanged { get; set; }
    [Parameter] public EventCallback OnQuickAdd { get; set; }
    [Parameter] public int DeletedCount { get; set; } = 0;
}

